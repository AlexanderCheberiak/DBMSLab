<Window x:Class="Dbms.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBMS Desktop Client" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Load Database" Width="120" Margin="0,0,10,0" Click="LoadDb_Click"/>
            <Button Content="Save Database" Width="120" Margin="0,0,10,0" Click="SaveDb_Click"/>
            <Button Content="Refresh Tables" Width="120" Margin="0,0,10,0" Click="Refresh_Click"/>
            <ComboBox x:Name="TableSelector" Width="150" SelectionChanged="TableSelector_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="DataGridMain" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox x:Name="TxtInput" Width="400" Margin="0,0,10,0" />
            <Button Content="Add Row (JSON format)" Width="150" Click="AddRow_Click"/>
        </StackPanel>
    </Grid>
</Window>