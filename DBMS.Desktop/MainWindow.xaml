<Window x:Class="Dbms.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBMS" Height="650" Width="1000" Background="#F5F6F7" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="BorderBrush" Value="#ADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Верхня панель інструментів -->
        <!-- Верхня панель інструментів -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Активна БД:" FontWeight="Bold" Margin="0,0,5,0"/>
                <ComboBox x:Name="ComboDatabases" Width="150" SelectionChanged="ComboDatabases_SelectionChanged" Margin="0,0,20,0"/>

                <Button Content="Відкрити з файлу" Click="LoadFromFile_Click" Margin="0,0,5,0" Background="#E8F4F8"/>
                <Button Content="Зберегти у файл" Click="SaveToFile_Click" Margin="0,0,25,0" Background="#E8F4F8"/>

                <TextBlock Text="Назва для нової/перейменування:" Margin="0,0,5,0"/>
                <TextBox x:Name="TxtDbName" Width="140" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                <Button Content="Створити" Click="CreateDb_Click" Margin="0,0,5,0"/>
                <Button Content="Перейменувати" Click="RenameDb_Click" Margin="0,0,25,0"/>

                <Button Content="Оновити список" Click="Refresh_Click"/>
            </WrapPanel>
        </Border>

        <!-- Статус-бар внизу -->
        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Бічна панель: Оглядач об'єктів -->
        <Border DockPanel.Dock="Left" Width="220" BorderBrush="#CCC" BorderThickness="0,0,1,0" Background="White">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1">
                    <TextBlock Text="Оглядач об'єктів" FontWeight="Bold" Padding="10"/>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <TextBlock Text="Нова назва:" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtRenameTable" Padding="4" Margin="0,0,0,5"/>
                    <Button Content="Перейменувати таблицю" Click="RenameTable_Click" Margin="0,0,0,10"/>
                    <Button Content="Видалити таблицю" Click="DeleteTable_Click" Background="#DC3545" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <ListBox x:Name="ListTables" SelectionChanged="ListTables_SelectionChanged" BorderThickness="0" Padding="5"/>
            </DockPanel>
        </Border>

        <!-- Центральна робоча зона -->
        <TabControl Margin="10" Background="White" BorderBrush="#CCC">

            <!-- Вкладка 1: Робота з даними -->
            <TabItem Header="Дані таблиці">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="DataGridMain" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#CCC" AlternatingRowBackground="#F9F9F9" Margin="0,0,15,0" HeadersVisibility="Column" SelectionChanged="DataGridMain_SelectionChanged" SelectionMode="Single"/>

                    <!-- Бічна панель операцій -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ДОДАВАННЯ ЗАПИСУ" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                            <StackPanel x:Name="PanelRowInputs"/>
                            <Button Content="Вставити новий" Click="AddRow_Click" Margin="0,10,0,5" Background="#28A745" Foreground="White" BorderThickness="0"/>
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Оновити" Click="EditRow_Click" Margin="0,0,5,0" Background="#FFC107" BorderThickness="0"/>
                                <Button Grid.Column="1" Content="Видалити" Click="DeleteRow_Click" Margin="5,0,0,0" Background="#DC3545" Foreground="White" BorderThickness="0"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#EEE" Margin="0,0,0,20"/>

                            <TextBlock Text="ПРОЄКЦІЯ ТАБЛИЦІ" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                            <TextBlock Text="Виберіть колонки (Ctrl+Клік):" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                            <ListBox x:Name="ListProjectColumns" SelectionMode="Multiple" Height="120" BorderBrush="#CCC" Margin="0,0,0,10"/>
                            <TextBox x:Name="TxtProjectName" Text="Назва_нової_таблиці" Foreground="Gray" GotFocus="TxtProjectName_GotFocus" Margin="0,0,0,10"/>
                            <Button Content="Виконати проєкцію" Click="Project_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Конструктор таблиць -->
            <TabItem Header="Конструктор таблиць">
                <StackPanel Margin="20" HorizontalAlignment="Left" Width="600">
                    <TextBlock Text="Назва нової таблиці:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNewTableName" Padding="5" Margin="0,0,0,20"/>

                    <TextBlock Text="Додавання колонок:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ім'я колонки" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="Тип даних" Grid.Column="1" Foreground="#666"/>
                        <TextBlock Text="Початок" Grid.Column="2" Foreground="#666" ToolTip="Для інтервальних типів"/>
                        <TextBlock Text="Кінець" Grid.Column="3" Foreground="#666" ToolTip="Для інтервальних типів"/>

                        <TextBox x:Name="TxtColName" Grid.Column="0" Margin="0,20,10,0"/>
                        <ComboBox x:Name="ComboColType" Grid.Column="1" Margin="0,20,10,0"/>
                        <TextBox x:Name="TxtInvStart" Grid.Column="2" Margin="0,20,10,0" MaxLength="1"/>
                        <TextBox x:Name="TxtInvEnd" Grid.Column="3" Margin="0,20,10,0" MaxLength="1"/>
                        <Button Content="Додати" Grid.Column="4" Margin="0,20,0,0" Click="AddColumn_Click"/>
                    </Grid>

                    <Border BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" Padding="10" Margin="0,0,0,20" MinHeight="100">
                        <StackPanel>
                            <TextBlock Text="Схема поточної таблиці:" FontWeight="Bold" Foreground="#666" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtPendingCols" Text="Колонки відсутні" Foreground="#333" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Створити таблицю" Click="CreateTable_Click" Width="200" HorizontalAlignment="Left" Background="#28A745" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>