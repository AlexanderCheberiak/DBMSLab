<Window x:Class="Dbms.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBMS Desktop Client" Height="600" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Load Database" Width="100" Margin="0,0,10,0" Click="LoadDb_Click"/>
            <Button Content="Save Database" Width="100" Margin="0,0,10,0" Click="SaveDb_Click"/>
            <Button Content="Refresh Tables" Width="100" Margin="0,0,15,0" Click="Refresh_Click"/>
            <TextBlock Text="Вибір таблиці:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="TableSelector" Width="150" SelectionChanged="TableSelector_SelectionChanged"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DataGridMain" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,10,10"/>

            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="ДОДАТИ РЯДОК" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel x:Name="PanelRowInputs" Margin="0,0,0,10"/>
                <Button Content="Зберегти рядок" Click="AddRow_Click" Height="30" Margin="0,0,0,20"/>

                <TextBlock Text="ПРОЄКЦІЯ ТАБЛИЦІ" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Оберіть колонки (через Ctrl):" FontSize="11" Margin="0,0,0,5"/>
                <ListBox x:Name="ListProjectColumns" SelectionMode="Multiple" Height="100" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtProjectName" Text="Назва нової таблиці" Margin="0,0,0,5" Foreground="Gray" GotFocus="TxtProjectName_GotFocus"/>
                <Button Content="Виконати проєкцію" Click="Project_Click" Height="30"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="СТВОРЕННЯ НОВОЇ ТАБЛИЦІ" Padding="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="TxtColName" Width="100" ToolTip="Назва колонки" Margin="0,0,10,0" Text="ColName"/>
                    <ComboBox x:Name="ComboColType" Width="120" Margin="0,0,10,0"/>
                    <TextBlock Text="Інтервал (для charInvl):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtInvStart" Width="30" ToolTip="Початок (напр. a)" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtInvEnd" Width="30" ToolTip="Кінець (напр. z)" Margin="0,0,10,0"/>
                    <Button Content="Додати колонку" Click="AddColumn_Click" Width="120"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Колонки: " FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPendingCols" Text="Немає" Margin="0,0,20,0" Width="300" TextWrapping="Wrap"/>
                    <TextBox x:Name="TxtNewTableName" Width="150" ToolTip="Назва таблиці" Margin="0,0,10,0" Text="NewTableName"/>
                    <Button Content="Зберегти таблицю" Click="CreateTable_Click" Width="150" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>