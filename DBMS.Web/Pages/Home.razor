@page "/"
@using Dbms.Core
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS

<div style="background-color: #F5F6F7; min-height: 100vh; color: #333; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <!-- Верхня панель інструментів -->
    <div class="d-flex align-items-center bg-white border-bottom p-2 shadow-sm">
        <strong class="me-2">Активна БД:</strong>
        <select class="form-select form-select-sm w-auto me-3" @onchange="OnDbChanged">
            @foreach (var dbName in databases)
            {
                <option value="@dbName" selected="@(dbName == currentDbName)">@dbName</option>
            }
        </select>

        <InputFile OnChange="@LoadFromFile" accept=".json" class="d-none" id="fileUpload" />
        <button class="btn btn-sm btn-outline-secondary me-2" onclick="document.getElementById('fileUpload').click()">Відкрити з файлу</button>
        <button class="btn btn-sm btn-outline-secondary me-3" @onclick="SaveToFile">Зберегти у файл</button>

        <span class="border-start mx-2"></span>

        <input class="form-control form-control-sm w-auto me-2 ms-2" @bind="newDbName" placeholder="Назва для нової/перейменування" />
        <button class="btn btn-sm btn-light border me-2" @onclick="CreateDb">Створити</button>
        <button class="btn btn-sm btn-light border me-3" @onclick="RenameDb">Перейменувати</button>

        <button class="btn btn-sm btn-light border ms-auto" @onclick="LoadDatabasesList">Оновити список</button>
    </div>

    <!-- Статус бар -->
    <div class="bg-primary text-white px-3 py-1" style="font-size: 0.85rem;">
        @statusMessage
    </div>

    <div class="d-flex" style="height: calc(100vh - 85px);">
        <!-- Бічна панель: Оглядач об'єктів -->
        <div class="bg-white border-end" style="width: 250px; overflow-y: auto;">
            <div class="bg-light border-bottom p-2 fw-bold text-secondary">Оглядач об'єктів</div>

            <div class="p-2 border-bottom">
                <input class="form-control form-control-sm mb-2" @bind="tableRenameInput" placeholder="Нова назва таблиці" />
                <div class="d-flex justify-content-between">
                    <button class="btn btn-sm btn-light border" style="width: 48%;" @onclick="RenameTable">Змінити</button>
                    <button class="btn btn-sm btn-danger" style="width: 48%;" @onclick="DeleteTable">Видалити</button>
                </div>
            </div>

            <div class="list-group list-group-flush">
                @if (currentDb?.Tables != null)
                {
                    @foreach (var table in currentDb.Tables)
                    {
                        <button class="list-group-item list-group-item-action @(selectedTable?.Name == table.Name ? "active" : "")"
                                @onclick="() => SelectTable(table)">
                            @table.Name
                        </button>
                    }
                }
            </div>
        </div>

        <!-- Центральна робоча зона -->
        <div class="p-3 flex-grow-1" style="overflow-y: auto;">
            <ul class="nav nav-tabs mb-3 bg-white pt-2 px-2 border-bottom-0 shadow-sm">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "Data" ? "active fw-bold" : "")" @onclick='() => activeTab = "Data"'>Дані таблиці</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "Designer" ? "active fw-bold" : "")" @onclick='() => activeTab = "Designer"'>Конструктор таблиць</button>
                </li>
            </ul>

            <div class="bg-white p-3 border shadow-sm h-100">
                @if (activeTab == "Data")
                {
                    @if (selectedTable != null)
                    {
                        <div class="d-flex">
                            <div class="flex-grow-1 me-4">
                                <table class="table table-bordered table-hover table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            @foreach (var col in selectedTable.Columns)
                                            {
                                                <th>@col.Name</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in selectedTable.Rows)
                                        {
                                            <tr @onclick="() => SelectRow(row)" class="@(selectedRowId == row.Id ? "table-primary" : "")" style="cursor:pointer;">
                                                <td>@row.Id</td>
                                                @foreach (var col in selectedTable.Columns)
                                                {
                                                    <td>@(row.Values.ContainsKey(col.Name) ? row.Values[col.Name] : "")</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div style="width: 300px;">
                                <div class="fw-bold mb-2">ОПЕРАЦІЇ З РЯДКАМИ</div>
                                @foreach (var col in selectedTable.Columns)
                                {
                                    <div class="mb-2">
                                        <label class="form-label text-muted small mb-1">@col.Name (@col.Type)</label>
                                        <input class="form-control form-control-sm" @bind="rowInputs[col.Name]" />
                                    </div>
                                }
                                <div class="d-grid gap-2 mt-3 mb-4">
                                    <button class="btn btn-sm btn-success" @onclick="AddRow">Вставити новий запис</button>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-warning w-50" @onclick="UpdateRow">Оновити обраний</button>
                                        <button class="btn btn-sm btn-danger w-50" @onclick="DeleteRow">Видалити обраний</button>
                                    </div>
                                </div>

                                <hr />
                                <div class="fw-bold mb-2">ПРОЄКЦІЯ ТАБЛИЦІ</div>
                                <select multiple class="form-control form-control-sm mb-2" @bind="selectedProjectColumns" style="height: 100px;">
                                    @foreach (var col in selectedTable.Columns)
                                    {
                                        <option value="@col.Name">@col.Name</option>
                                    }
                                </select>
                                <input class="form-control form-control-sm mb-2" @bind="projectTableName" placeholder="Назва нової таблиці" />
                                <button class="btn btn-sm btn-secondary w-100" @onclick="ProjectTable">Виконати проєкцію</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Оберіть таблицю зі списку ліворуч.</div>
                    }
                }
                else if (activeTab == "Designer")
                {
                    <div style="max-width: 600px;">
                        <div class="mb-4">
                            <label class="fw-bold mb-1">Назва нової таблиці:</label>
                            <input class="form-control" @bind="newTableDesignerName" />
                        </div>

                        <div class="fw-bold mb-2">Додавання колонок:</div>
                        <div class="row g-2 mb-4 align-items-end">
                            <div class="col-4">
                                <label class="small text-muted">Ім'я</label>
                                <input class="form-control form-control-sm" @bind="newColName" />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted">Тип</label>
                                <select class="form-select form-select-sm" @bind="newColType">
                                    @foreach (var type in Enum.GetValues<ColumnType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                            <div class="col-1">
                                <label class="small text-muted">Від</label>
                                <input class="form-control form-control-sm" @bind="newColStart" maxlength="1" />
                            </div>
                            <div class="col-1">
                                <label class="small text-muted">До</label>
                                <input class="form-control form-control-sm" @bind="newColEnd" maxlength="1" />
                            </div>
                            <div class="col-3">
                                <button class="btn btn-sm btn-light border w-100" @onclick="AddColumnToDesigner">Додати</button>
                            </div>
                        </div>

                        <div class="border p-2 bg-light mb-4" style="min-height: 100px;">
                            <div class="fw-bold text-muted mb-2">Схема:</div>
                            @if (pendingColumns.Count == 0)
                            {
                                <span class="text-muted small">Колонки відсутні</span>
                            }
                            else
                            {
                                @foreach (var c in pendingColumns)
                                {
                                    <div class="small">
                                        - @c.Name (@c.Type)
                                        @(c.Type == ColumnType.CharInvl || c.Type == ColumnType.StringCharInvl ? $"[{c.IntervalStart}-{c.IntervalEnd}]" : "")
                                    </div>
                                }
                            }
                        </div>

                        <button class="btn btn-success" @onclick="CreateTable">Створити таблицю</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<string> databases = new();
    private Database? currentDb;
    private Table? selectedTable;
    private string currentDbName = "";
    private string newDbName = "";
    private string statusMessage = "Готово";
    private string activeTab = "Data";

    // Дані таблиці та операції з рядками
    private Dictionary<string, string> rowInputs = new();
    private int? selectedRowId = null;
    private string tableRenameInput = "";

    // Проєкція
    private string[] selectedProjectColumns = Array.Empty<string>();
    private string projectTableName = "ProjectTable_1";

    // Конструктор таблиць
    private string newTableDesignerName = "";
    private string newColName = "";
    private ColumnType newColType = ColumnType.Integer;
    private string newColStart = "";
    private string newColEnd = "";
    private List<Column> pendingColumns = new();

    protected override async Task OnInitializedAsync() => await LoadDatabasesList();

    private async Task LoadDatabasesList()
    {
        var response = await Http.GetAsync("api/databases");
        if (response.IsSuccessStatusCode)
        {
            databases = await response.Content.ReadFromJsonAsync<List<string>>() ?? new();
            if (databases.Count > 0 && string.IsNullOrEmpty(currentDbName)) currentDbName = databases[0];
            await LoadCurrentDatabase();
        }
    }

    private async Task LoadCurrentDatabase()
    {
        if (string.IsNullOrEmpty(currentDbName)) return;
        var response = await Http.GetAsync($"api/databases/{currentDbName}");
        if (response.IsSuccessStatusCode)
        {
            currentDb = await response.Content.ReadFromJsonAsync<Database>();
            if (currentDb?.Tables != null)
            {
                var match = currentDb.Tables.FirstOrDefault(t => t.Name == selectedTable?.Name);
                SelectTable(match ?? currentDb.Tables.FirstOrDefault());
            }
            StateHasChanged();
        }
    }

    private async Task OnDbChanged(ChangeEventArgs e)
    {
        currentDbName = e.Value?.ToString() ?? "";
        selectedTable = null;
        await LoadCurrentDatabase();
    }

    private void SelectTable(Table? table)
    {
        selectedTable = table;
        selectedRowId = null;
        rowInputs.Clear();
        selectedProjectColumns = Array.Empty<string>();
        if (table != null)
        {
            foreach (var col in table.Columns) rowInputs[col.Name] = "";
        }
    }

    private void SelectRow(Row row)
    {
        selectedRowId = row.Id;
        foreach (var col in selectedTable!.Columns)
        {
            rowInputs[col.Name] = row.Values.ContainsKey(col.Name) ? row.Values[col.Name] : "";
        }
    }

    private async Task CreateDb()
    {
        if (string.IsNullOrWhiteSpace(newDbName)) return;
        var response = await Http.PostAsync($"api/databases/{newDbName}", null);
        if (response.IsSuccessStatusCode) { statusMessage = $"БД {newDbName} створено."; await LoadDatabasesList(); }
    }

    private async Task RenameDb()
    {
        if (string.IsNullOrEmpty(currentDbName) || string.IsNullOrWhiteSpace(newDbName)) return;
        var response = await Http.PutAsync($"api/databases/{currentDbName}/rename?newName={newDbName}", null);
        if (response.IsSuccessStatusCode) { statusMessage = "БД перейменовано."; await LoadDatabasesList(); }
    }

    private async Task SaveToFile()
    {
        if (string.IsNullOrEmpty(currentDbName)) return;
        var response = await Http.GetAsync($"api/databases/{currentDbName}");
        if (response.IsSuccessStatusCode)
        {
            var json = await response.Content.ReadAsStringAsync();
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64", $"{currentDbName}.json", base64);
            statusMessage = "Файл завантажено в браузер.";
        }
    }

    private async Task LoadFromFile(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10485760);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var db = JsonSerializer.Deserialize<Database>(json, options);

            if (db != null && !string.IsNullOrWhiteSpace(db.Name))
            {
                var response = await Http.PostAsJsonAsync("api/databases/import", db);
                if (response.IsSuccessStatusCode)
                {
                    statusMessage = $"БД '{db.Name}' успішно імпортовано.";
                    await LoadDatabasesList();
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Помилка читання файлу.";
        }
    }

    private async Task RenameTable()
    {
        if (selectedTable == null || string.IsNullOrWhiteSpace(tableRenameInput)) return;
        var response = await Http.PutAsync($"api/databases/{currentDbName}/tables/{selectedTable.Name}/rename?newName={tableRenameInput}", null);
        if (response.IsSuccessStatusCode) { statusMessage = "Таблицю перейменовано."; tableRenameInput = ""; await LoadCurrentDatabase(); }
    }

    private async Task DeleteTable()
    {
        if (selectedTable == null) return;
        var response = await Http.DeleteAsync($"api/databases/{currentDbName}/tables/{selectedTable.Name}");
        if (response.IsSuccessStatusCode) { statusMessage = "Таблицю видалено."; selectedTable = null; await LoadCurrentDatabase(); }
    }

    private async Task AddRow()
    {
        if (selectedTable == null) return;
        var response = await Http.PostAsJsonAsync($"api/databases/{currentDbName}/tables/{selectedTable.Name}/rows", rowInputs);
        if (response.IsSuccessStatusCode) { statusMessage = "Запис додано."; await LoadCurrentDatabase(); }
        else statusMessage = "Помилка валідації даних.";
    }

    private async Task UpdateRow()
    {
        if (selectedTable == null || selectedRowId == null) return;
        var response = await Http.PutAsJsonAsync($"api/databases/{currentDbName}/tables/{selectedTable.Name}/rows/{selectedRowId}", rowInputs);
        if (response.IsSuccessStatusCode) { statusMessage = "Запис оновлено."; await LoadCurrentDatabase(); }
        else statusMessage = "Помилка валідації.";
    }

    private async Task DeleteRow()
    {
        if (selectedTable == null || selectedRowId == null) return;
        var response = await Http.DeleteAsync($"api/databases/{currentDbName}/tables/{selectedTable.Name}/rows/{selectedRowId}");
        if (response.IsSuccessStatusCode) { statusMessage = "Запис видалено."; selectedRowId = null; await LoadCurrentDatabase(); }
    }

    private async Task ProjectTable()
    {
        if (selectedTable == null || selectedProjectColumns.Length == 0) return;
        var response = await Http.PostAsJsonAsync($"api/databases/{currentDbName}/tables/{selectedTable.Name}/project?newName={projectTableName}", selectedProjectColumns.ToList());
        if (response.IsSuccessStatusCode) { statusMessage = "Проєкцію створено."; await LoadCurrentDatabase(); }
    }

    private void AddColumnToDesigner()
    {
        if (string.IsNullOrWhiteSpace(newColName)) return;
        pendingColumns.Add(new Column { Name = newColName, Type = newColType, IntervalStart = newColStart, IntervalEnd = newColEnd });
        newColName = ""; newColStart = ""; newColEnd = "";
    }

    private async Task CreateTable()
    {
        if (string.IsNullOrWhiteSpace(newTableDesignerName) || pendingColumns.Count == 0) return;
        var newTable = new Table { Name = newTableDesignerName, Columns = pendingColumns.ToList() };
        var response = await Http.PostAsJsonAsync($"api/databases/{currentDbName}/tables", newTable);
        if (response.IsSuccessStatusCode)
        {
            statusMessage = "Таблицю створено.";
            newTableDesignerName = "";
            pendingColumns.Clear();
            activeTab = "Data";
            await LoadCurrentDatabase();
        }
    }
}